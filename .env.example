# SecretAIry の環境変数の名前の見本（値はすべて空）。
# 手元では、このファイルを .env.local に写して値を入れます（.env.local はコミットしません）。
# Vercel では、プロジェクトの環境変数に入れます。
# 何も入れなくても画面は開き、AI を使う所は「決まった返事（AI なし）」で同じ流れを試せます。
# 区切りは README の「環境変数」の表の「要る？」と同じです。

# ── AI を使うとき ──
# Claude API の鍵。無ければ、朝の要点の「AI の一言」・ルールを言葉で書いて足す欄・広告の判定と報告の一言は出ません
ANTHROPIC_API_KEY=

# ── 任意（モデル名を差しかえる。無ければ config/ai.json の名前） ──
# 予約チャット・広告の見直し・発信（Sonnet）
ANTHROPIC_MODEL=
# カルテと録音の要点（Haiku）
ANTHROPIC_KARTE_MODEL=
# LINE の一言の振り分け（Haiku）
ANTHROPIC_LINE_MODEL=
# ToDo のメモを投げる（Haiku）
ANTHROPIC_TODO_MODEL=
# 朝の要点の「AI の一言」（Haiku）
ANTHROPIC_BRIEF_MODEL=
# ルールを言葉で書いて足す入口（Haiku）
ANTHROPIC_RULES_MODEL=

# ── LINE を使うとき（LINE とつなぐ・オーナー側） ──
# LINE のチャネルの秘密（届いた知らせの署名を確かめる）
LINE_CHANNEL_SECRET=
# LINE に返事・送るときの鍵
LINE_CHANNEL_ACCESS_TOKEN=
# Upstash Redis（Vercel がつないだときに自動で入る名前）
KV_REST_API_URL=
KV_REST_API_TOKEN=
# 上の2つが無い時だけ、こちらの名前でも読みます（どちらか一方でよい）
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── 任意（LINE） ──
# オーナー用の合言葉。あれば「LINE とつなぐ」を押す時に求め、無ければ求めません
LINE_OWNER_PASSCODE=

# ── 試験10問を流すとき ──
# 試験（/eval）の合言葉。無ければ試験は動きません（試験の見張りに上の Redis も使います）
EVAL_PASSCODE=

# ── 経理の freee（テスト事業所）を使うとき（Vercel の Production だけ） ──
# 本番のサイト（secretairy.vercel.app）でだけ動きます。手元やプレビューでは、入れても freee の窓口は止まります
FREEE_CLIENT_ID=
FREEE_CLIENT_SECRET=
# テスト事業所の番号
FREEE_COMPANY_ID=
# cookie を暗号化する専用の鍵（32バイトを base64 にした文字）
FREEE_COOKIE_KEY=

# VERCEL_ENV・VERCEL_GIT_COMMIT_SHA は Vercel が自動で入れる名前なので、ここには書きません。
